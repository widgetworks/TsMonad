{
  "name": "@wiwo/tsmonad",
  "version": "3.0.1",
  "description": "TsMonad - fun-size monads library for TypeScript",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/*",
    "LICENSE-MIT",
    "README.md"
  ],
  "directories": {},
  "scripts": {
    "clean": "rm -rf dist lib",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "prepublish": "npm run build",
    "pretest": "npm run clean && npm run build:test",
    "test": "mocha dist/test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/widgetworks/TsMonad.git"
  },
  "keywords": [
    "typescript",
    "monad",
    "functional"
  ],
  "author": {
    "name": "Chris Bowdon",
    "url": "https://github.com/cbowdon"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.1.0",
    "@types/underscore": "^1.8.0",
    "assert": "^2.1.0",
    "mocha": "^11.7.1",
    "typescript": "^5.9.2",
    "underscore": "^1.13.7"
  }
}
